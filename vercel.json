{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/interactions/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/interactions/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/interactions",
      "destination": "/interactions/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
